# PostgreSQL connection string (Neon, or the local docker-compose Postgres)
DATABASE_URL=postgres://nearling:nearling_dev@localhost:5432/nearling

# Shared secret that sensor gateways / the simulator must send as X-Ingest-Key.
# Used as the demo organization's ingest key at seed time (pnpm seed).
VITALS_INGEST_KEY=change-me

# Secret for signing session cookies. Generate one with: openssl rand -base64 32
# In dev it can be left unset (a dev-only fallback is used, with a warning).
AUTH_SECRET=

# Demo user created by pnpm seed (login page credentials)
SEED_EMAIL=demo@nearling.dev
SEED_PASSWORD=demo1234

# Frontend demo mode: true renders the dashboard from the built-in mock data,
# so the UI works without a database. Leave false for real data.
NEXT_PUBLIC_DEMO_MODE=false

# Frontend realtime transport:
#   polling (default) - re-fetches every 10s; works everywhere
#   sse               - EventSource on /api/stream pushes on new readings;
#                       best on a single-node deployment (self-hosted)
NEXT_PUBLIC_REALTIME=polling

# Your trained model server (optional).
# When set, the backend calls POST /predict on it for every vital reading.
# See docs/MODEL_CONTRACT.md and model-server/ for the contract.
# MODEL_API_URL=http://localhost:8000

# Model client behavior:
#   fallback (default) - use the rule-based classifier when the model is unreachable
#   strict            - reject the reading if the model fails
MODEL_FALLBACK_MODE=fallback
MODEL_TIMEOUT_MS=3000
